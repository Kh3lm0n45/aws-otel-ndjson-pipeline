{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOnlyToOwnPrefix",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::raw-otel-logs/asset-01/*"
    },
    {
      "Sid": "KmsForSseKmsWrites",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "arn:aws:kms:eu-west-2:123456789012:key/00000000-0000-0000-0000-000000000000"
    }
  ]
}
